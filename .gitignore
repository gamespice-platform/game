# Every gs-* addon is a separate repository. For local development, symlink them:
#   ln -s ../../gs-core/addons/gs_core     addons/gs_core
#   ln -s ../../gs-server/addons/gs_server addons/gs_server
#   ln -s ../../gs-net/addons/gs_net       addons/gs_net
# Consumers copy what they need into their own project.
